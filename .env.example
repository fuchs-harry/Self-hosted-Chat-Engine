# ============================================================================
# Self-hosted Chat Engine: configuration
# Copy to .env and fill in the two REQUIRED values. Everything else is
# optional; model providers can also be connected later in the admin UI.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# Long random string. Encrypts API keys stored in the database.
# Generate: openssl rand -hex 32   (keep it safe: changing it invalidates stored keys)
APP_SECRET=

# Database password used by docker-compose.yml
POSTGRES_PASSWORD=

# --- General ----------------------------------------------------------------

# Name shown in the UI and the browser tab.
APP_NAME=Chat Engine
# Default UI language: de | en (users can switch)
APP_LOCALE=de
# Public URL; https:// enables secure cookies.
# APP_URL=https://chat.firma.at
# APP_PORT=3000

# Create the first admin automatically (otherwise the first visit to /setup does it).
# ADMIN_EMAIL=it@firma.at
# ADMIN_PASSWORD=

# When not using docker-compose, point at your own Postgres (needs pgvector):
# DATABASE_URL=postgres://chat:secret@db.internal:5432/chat

# --- Model providers --------------------------------------------------------
# Set the key of any provider you want to use. Each one can alternatively be
# connected in Administration -> Models. Override a provider's model list with
# <PROVIDER>_MODELS=model-a,model-b (first = default).

# On-prem: Ollama (docker compose --profile ollama up -d)
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODELS=qwen3:30b-a3b,gpt-oss:20b

# On-prem: any OpenAI-compatible server (vLLM, LM Studio, LiteLLM, ...)
# CUSTOM_LLM_BASE_URL=http://vllm:8000/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct

# EU: Mistral AI (Paris)
# MISTRAL_API_KEY=

# EU: STACKIT (DE/AT data centers)
# STACKIT_API_KEY=

# EU: IONOS AI Model Hub (DE)
# IONOS_API_KEY=

# EU: Scaleway Generative APIs (FR)
# SCALEWAY_API_KEY=

# EU: Azure OpenAI, deployments of type "Data Zone Standard (EU)".
# Model ids below are your deployment names.
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_API_KEY=
# AZURE_MODELS=gpt-5.5,gpt-5.4-mini

# EU: Amazon Bedrock with EU inference profiles (eu.anthropic.claude-...)
# AWS_REGION=eu-central-1
# AWS_BEARER_TOKEN_BEDROCK=

# EU: Google Vertex AI with a regional endpoint
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=europe-west3
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account",...}

# EU optional: OpenAI (EU residency needs an approved project + eu.api.openai.com)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://eu.api.openai.com/v1

# Non-EU: Anthropic direct API (prefer Bedrock/Vertex for EU processing)
# ANTHROPIC_API_KEY=

# --- Models -----------------------------------------------------------------

# Default chat model as provider:model (otherwise: best residency first).
# DEFAULT_MODEL=mistral:mistral-medium-latest
# Model for background work (titles, memory). Defaults to DEFAULT_MODEL.
# UTILITY_MODEL=ollama:qwen3:30b-a3b

# Embedding model for search, as provider:model. Auto-picked if unset
# (on-prem first). Changing it later re-indexes everything automatically.
# EMBEDDING_MODEL=ollama:bge-m3
# EMBEDDING_DIMENSIONS=1024

# --- Knowledge & connectors -------------------------------------------------

# Folders the "Network share" connector may read (comma separated).
CONNECTOR_FOLDER_ROOTS=/data/shares
# Max upload size per file in MB.
MAX_UPLOAD_MB=25

# --- Heartbeat --------------------------------------------------------------

# Background loop for indexing, connector syncs, memory and retention.
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30
